# Python bytecode cache — auto-generated, never commit these
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
env/
.env/

# pytest / ruff caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Logs and reports generated at runtime
logs/
reports/
test-results/

# Local secrets and credentials — never commit
.env
*.pem
*.key
secrets.enc

# OS noise
.DS_Store
Thumbs.db

# Db2 local-only configs (keep db2.example.yaml tracked)
config/db2_e2e*.yaml
config/db2_test*.yaml
config/db2_client.yaml
config/db2_connection_test.yaml
